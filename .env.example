# Base URL of the API gateway the frontend talks to.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: comma-separated bootstrap service URLs (leave empty for local dev).
NEXT_PUBLIC_BOOTSTRAP_SERVICE_URLS=

# Optional: comma-separated hosts serving word audio/images. These are cached by
# the service worker so practice works offline. Defaults to the hosts used by the
# seed corpus (Cambridge + Memrise audio, Langeek images).
NEXT_PUBLIC_MEDIA_HOSTS=dictionary.cambridge.org,cdn.langeek.co,static.memrise.com
