# Base URL of the API gateway the frontend talks to.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: the services' own public base URLs, comma-separated (auth,
# vocabulary, learning) — NOT the gateway, which NEXT_PUBLIC_API_URL already
# covers. Leave empty for local dev and for any deployment whose instances stay
# warm.
#
# Only used to wake suspended free-tier instances. On boot the browser fires one
# opaque `no-cors` GET at `<url>/health` per entry: it cannot read the answer
# (the services send no CORS headers for this origin, by design) but the request
# still reaches the platform's router, which is what starts the container. That
# makes all four cold starts overlap, instead of waiting for the gateway to boot
# before it can start waking the three services behind it.
#
# Readiness is still reported by the gateway's /wake, never by these.
NEXT_PUBLIC_BOOTSTRAP_SERVICE_URLS=

# Optional: comma-separated hosts serving word audio/images. These are cached by
# the service worker so practice works offline. Defaults to the hosts used by the
# seed corpus (Cambridge + Memrise audio, Langeek images).
NEXT_PUBLIC_MEDIA_HOSTS=dictionary.cambridge.org,cdn.langeek.co,static.memrise.com
